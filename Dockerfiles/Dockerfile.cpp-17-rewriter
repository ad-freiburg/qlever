# Image for the source-rewriting steps (currently only the rewriting of
# `using enum`) of the `CPP17 libQLever` CI workflow.
#
# The base image `ghcr.io/joka921/llvm-cpp-17-rewriter` (built from the
# Dockerfile at
# https://github.com/joka921/llvm-project/blob/fork-for-qlever/Dockerfile,
# which will be moved to a more stable location) contains a custom clang
# build together with the `backport-using-enum` tool in `/opt/llvm/bin`. We only
# rely on those LLVM tools and install everything that is needed to configure
# QLever (in particular to generate a `compile_commands.json`) on top of it.
# That way a new QLever dependency only requires a change in this file and not a
# rebuild of the base image.
FROM ghcr.io/joka921/llvm-cpp-17-rewriter:0.0.1

ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8
ENV LC_CTYPE=C.UTF-8

# All the dependencies of QLever. Keep this in sync with the `Dockerfile` in the
# root directory and with `.github/workflows/install-dependencies-ubuntu`. The
# Ubuntu version of the base image is recent enough that all of them (in
# particular CMake and Boost) can be installed directly from the standard
# repositories.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    cmake \
    git \
    libboost-container-dev \
    libboost-dev \
    libboost-filesystem-dev \
    libboost-iostreams-dev \
    libboost-program-options-dev \
    libboost-url-dev \
    libicu-dev \
    libjemalloc-dev \
    libssl-dev \
    liburing-dev \
    libzstd-dev \
    mold \
    ninja-build \
    pkg-config \
    python3 \
    python3-icu \
    python3-yaml \
    tzdata \
    unzip \
    uuid-dev \
    uuid-runtime \
    && rm -rf /var/lib/apt/lists/*

# The base image sets these already, but we repeat them such that this image
# also works if the base image ever stops doing so.
ENV PATH="/opt/llvm/bin:${PATH}"
ENV LD_LIBRARY_PATH="/opt/llvm/lib:${LD_LIBRARY_PATH}"

WORKDIR /src
CMD ["/bin/bash"]
