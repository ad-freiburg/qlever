# Image for the source-rewriting steps (currently only the rewriting of
# `using enum`) of the `CPP17 libQLever` CI workflow.
#
# The base image `ghcr.io/joka921/llvm-enum-rewriter` (built from the Dockerfile
# at https://github.com/joka921/llvm-project) contains a custom clang-21 build
# together with the `backport-using-enum` tool in `/opt/llvm/bin`. We only rely
# on those LLVM tools and install everything that is needed to configure QLever
# (in particular to generate a `compile_commands.json`) on top of it. That way a
# new QLever dependency only requires a change in this file and not a rebuild of
# the base image.
FROM ghcr.io/joka921/llvm-enum-rewriter:latest

ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8
ENV LC_CTYPE=C.UTF-8

# The tools that are needed to add the additional apt repositories below.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates gnupg software-properties-common wget

# QLever requires a CMake version that is newer than the one shipped with the
# base image's Ubuntu release, so we use the official Kitware repository. The
# Boost version in the Ubuntu repositories is too old, so we use the PPA that
# provides the recent versions.
RUN wget -O kitware-archive.sh https://apt.kitware.com/kitware-archive.sh \
    && chmod +x kitware-archive.sh && ./kitware-archive.sh \
    && rm kitware-archive.sh
RUN add-apt-repository -y ppa:mhier/libboost-latest

# All the dependencies of QLever. Keep this in sync with the `Dockerfile` in the
# root directory and with `.github/workflows/install-dependencies-ubuntu`.
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    git \
    libicu-dev \
    libjemalloc-dev \
    libssl-dev \
    liburing-dev \
    libzstd-dev \
    mold \
    ninja-build \
    pkg-config \
    python3 \
    python3-icu \
    python3-yaml \
    tzdata \
    unzip \
    uuid-dev \
    uuid-runtime \
    libboost1.83-dev \
    libboost-container1.83-dev \
    libboost-filesystem1.83-dev \
    libboost-iostreams1.83-dev \
    libboost-program-options1.83-dev \
    libboost-url1.83-dev \
    && rm -rf /var/lib/apt/lists/*

# The base image sets these already, but we repeat them such that this image
# also works if the base image ever stops doing so.
ENV PATH="/opt/llvm/bin:${PATH}"
ENV LD_LIBRARY_PATH="/opt/llvm/lib:${LD_LIBRARY_PATH}"

WORKDIR /src
CMD ["/bin/bash"]
