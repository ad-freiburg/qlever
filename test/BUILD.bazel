# The Bazel counterpart of `test/CMakeLists.txt`.
#
# There is no equivalent of `SINGLE_TEST_BINARY`, and none is needed: Bazel
# caches and parallelizes per test target, so linking everything into one
# binary would only take away the granularity it needs. There is also no
# equivalent of `gtest_discover_tests`; a Bazel test target is always run as a
# whole, which is what `QLEVER_ONE_TEST_CASE_PER_FILE=ON` does in the CMake
# build. Use `--test_filter` to run individual test cases.
#
# The `_DISABLE_EMSCRIPTEN_PROBLEMATIC_TESTS` option of `test/CMakeLists.txt`
# has no counterpart here, because the Bazel build does not (yet) support
# Emscripten. All tests are therefore always defined.
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:qlever.bzl", "qlever_cc_binary", "qlever_cc_test")

package(default_visibility = ["//visibility:public"])

# The headers of `test/`, i.e. the shared test helpers. `qlever_cc_test` adds
# this to every test; the headers have to be declared even though most tests
# include them relative to themselves (for example as `../util/GTestHelpers.h`),
# because Bazel only makes declared files visible to a compile action.
#
# `includes` puts this directory on the include path, which some sources need
# because they spell the helpers as `../test/util/IdTableHelpers.h`. With CMake
# that resolves against `include_directories(src)`, since `src/../test/util/...`
# normalizes back to `test/util/...`; here `test/../test/util/...` does the same.
# Note that this is searched *after* QLever's own headers, because `includes`
# produces `-isystem` while the header targets in `src/` produce `-I`, so a name
# that exists under both `src/` and `test/` still resolves to the one in `src/`.
cc_library(
    name = "headers",
    # `allow_empty` because not every test directory has helper headers.
    hdrs = glob(
        ["**/*.h"],
        allow_empty = True,
    ),
    includes = ["."],
    deps = [
        "//test/backports:headers",
        "//test/engine:headers",
        "//test/engine/idTable:headers",
        "//test/index:headers",
        "//test/index/vocabulary:headers",
        "//test/joinAlgorithms:headers",
        "//test/libqlever:headers",
        "//test/parser:headers",
        "//test/parser/data:headers",
        "//test/rdfTypes:headers",
        "//test/util:headers",
    ],
)

