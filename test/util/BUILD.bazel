# The Bazel counterpart of `test/util/CMakeLists.txt`.

load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:qlever.bzl", "qlever_cc_library")

package(default_visibility = ["//visibility:public"])

# The headers of this directory. Unlike QLever's own headers these are not on any
# include path: the tests include their helpers relative to themselves, for
# example as `../util/GTestHelpers.h`. Declaring them is still necessary, because
# Bazel only makes declared files visible to a compile action. They are collected
# by `//test:headers`, which `qlever_cc_test` adds to every test.
cc_library(
    name = "headers",
    hdrs = glob(["**/*.h"]),
)

# The shared test helpers, which `qlever_cc_test` links into every test that
# does not pass `test_utils = False`. Unlike in the CMake build the headers are
# declared here rather than being visible globally, because `test/` is not on
# QLever's include path; see `//test:headers`.
# TODO<c++20> Once there is more support for it, we should be able to do this
# cheaper with modules.
qlever_cc_library(
    name = "testUtil",
    srcs = [
        "BenchmarkMeasurementContainerHelpers.cpp",
        "IdTableHelpers.cpp",
        "IndexTestHelpers.cpp",
        "RandomTestHelpers.cpp",
        "ValidatorHelpers.cpp",
    ],
    deps = [
        # `BenchmarkMeasurementContainerHelpers.h` includes
        # `../benchmark/infrastructure/BenchmarkMeasurementContainer.h`.
        "//benchmark:headers",
        "//src/engine",
        "//src/global",
        # The `.cpp` files here include their own headers as
        # `../test/util/...`, which needs `test/` on the include path; see
        # `//test:headers`.
        "//test:headers",
        "@googletest//:gtest_main",
    ],
)
