# CTRE, Compile-Time-Regular-Expressions. QLever includes `<ctre.hpp>` and
# `<ctre-unicode.hpp>` and uses the single-header distribution, just like the
# CMake build (`include_directories(SYSTEM ${ctre_SOURCE_DIR}/single-header)`).

load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

exports_files(["LICENSE"])

cc_library(
    name = "ctre",
    hdrs = glob(["single-header/*.hpp"]),
    includes = ["single-header"],
)
