# The two targets that BoringSSL's dependents in QLever's dependency graph refer
# to, backed by the system OpenSSL. Only `:crypto` is actually used, by
# `@s2geometry//s2/util/math/exactfloat`, which needs `BIGNUM`; `:ssl` exists
# because `@boost.asio` refers to it when it is built against BoringSSL, which
# QLever does not do.
#
# The headers do not have to be declared: they live in a directory that the C++
# toolchain searches by default, exactly as in `//bazel:system_library.bzl`.

load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "crypto",
    linkopts = ["-lcrypto"],
)

cc_library(
    name = "ssl",
    linkopts = ["-lssl"],
    deps = [":crypto"],
)
