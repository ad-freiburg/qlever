# The Bazel counterpart of `src/util/CMakeLists.txt`.

load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:qlever.bzl", "qlever_cc_library")

package(default_visibility = ["//visibility:public"])

# The headers of this directory, see `//src:qlever_hdrs`.
cc_library(
    name = "headers",
    hdrs = glob(["**/*.h"]),
    strip_include_prefix = "/src",
)

# The lowest layer: string helpers that depend on nothing but the standard
# library and ICU. Kept separate so that leaf targets (for example
# `LocaleManagerTest`) can use them without pulling in all of `qlever_util`.
qlever_cc_library(
    name = "stringUtils",
    srcs = ["StringUtils.cpp"],
)

# The error handling for the ANTLR-generated parsers. This has to be separate
# from `qlever_util`, because `rdfTypes` (which `qlever_util` depends on) needs
# it, and a single library would therefore be a cyclic dependency.
qlever_cc_library(
    name = "antlrErrorHandling",
    srcs = [
        "ParseException.cpp",
        "antlr/ANTLRErrorHandling.cpp",
        "antlr/GenerateAntlrExceptionMetadata.cpp",
    ],
    deps = [
        ":stringUtils",
        "@antlr4-cpp-runtime",
    ],
)

# The general-purpose utilities. Everything in here may depend on `rdfTypes`,
# so nothing that `rdfTypes` itself needs must be added to this library.
qlever_cc_library(
    name = "qlever_util",
    srcs = [
        "BlankNodeManager.cpp",
        "CancellationHandle.cpp",
        "Conversions.cpp",
        "Date.cpp",
        "DateYearDuration.cpp",
        "Duration.cpp",
        "FilesystemHelpers.cpp",
        "IoUringManager.cpp",
        "LazyJsonParser.cpp",
        "ParseableDuration.cpp",
        "QueryEventLog.cpp",
        "ResourceMonitor.cpp",
        "UnitOfMeasurement.cpp",
    ],
    deps = [
        ":antlrErrorHandling",
        "//src/rdfTypes",
        "@antlr4-cpp-runtime",
        "@pbutil//:pb_util",
        "@pbutil//:pb_util_geo",
        "@pbutil//:pb_util_json",
        "@s2geometry//:s2",
    ],
)
