# The Bazel counterpart of `src/util/http/HttpParser/CMakeLists.txt`.

load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:qlever.bzl", "qlever_cc_library")

package(default_visibility = ["//visibility:public"])

# The headers of this directory, see `//src:qlever_hdrs`.
cc_library(
    name = "headers",
    hdrs = glob(["**/*.h"]),
    strip_include_prefix = "/src",
)

# `AcceptHeaderQleverVisitor.h` is also listed in the sources of the `http`
# library in `src/util/http/CMakeLists.txt`, which is why it is exported here.
exports_files(["AcceptHeaderQleverVisitor.h"])

qlever_cc_library(
    name = "httpParser",
    srcs = [
        "AcceptHeaderQleverVisitor.cpp",
        "generated/AcceptHeaderBaseListener.cpp",
        "generated/AcceptHeaderLexer.cpp",
        "generated/AcceptHeaderListener.cpp",
        "generated/AcceptHeaderParser.cpp",
        "generated/AcceptHeaderVisitor.cpp",
    ],
    deps = [
        "//src/util:qlever_util",
        "@antlr4-cpp-runtime",
    ],
)
