# The Bazel counterpart of `src/parser/sparqlParser/CMakeLists.txt`.

load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:qlever.bzl", "qlever_cc_library")

package(default_visibility = ["//visibility:public"])

# The headers of this directory, see `//src:qlever_hdrs`.
cc_library(
    name = "headers",
    hdrs = glob(["**/*.h"]),
    strip_include_prefix = "/src",
)

# The same headers a second time, but reachable as `sparqlParser/...` instead of
# as `parser/sparqlParser/...`. Four headers and sources in `src/parser` include
# them relative to themselves rather than relative to `src`, for example
# `#include "sparqlParser/generated/SparqlAutomaticLexer.h"`. With CMake that
# resolves via the directory of the including file, but `strip_include_prefix`
# puts the headers into a virtual include directory, so the including file and
# its sibling directory no longer sit next to each other and the relative
# spelling does not resolve on its own.
cc_library(
    name = "headers_relative_to_parser",
    hdrs = glob(["**/*.h"]),
    strip_include_prefix = "/src/parser",
)

# `src/parser/CMakeLists.txt` compiles `sparqlParser/SparqlQleverVisitor.cpp`
# into the `parser` library rather than into `sparqlParser`, because it needs
# `sparqlExpressions`, which in turn needs this library. In Bazel a target may
# only use sources from its own package, so the file is exported for
# `//src/parser:parser`.
exports_files(["SparqlQleverVisitor.cpp"])

qlever_cc_library(
    name = "sparqlParser",
    srcs = [
        "generated/SparqlAutomaticBaseListener.cpp",
        "generated/SparqlAutomaticLexer.cpp",
        "generated/SparqlAutomaticListener.cpp",
        "generated/SparqlAutomaticParser.cpp",
        "generated/SparqlAutomaticVisitor.cpp",
    ],
    # Silence warnings in files that are auto-generated by ANTLR.
    # TODO<joka921> Submit a pull request to ANTLR to fix those warnings.
    copts = [
        "-Wno-logical-op-parentheses",
        "-Wno-parentheses",
    ],
    deps = ["@antlr4-cpp-runtime"],
)
